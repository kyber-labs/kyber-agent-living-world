# contoh — salin ke `.env` dan isi bila sudah ada
# Database dipakai mulai Phase 4 (AI Agent Engine + task management).
# Bila kosong, aplikasi tetap jalan; status database tampil "belum dikonfigurasi".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI Engine (Phase 4, pilihan Bos: Gemini tier gratis).
# Buat key di Google AI Studio (https://aistudio.google.com/app/apikey)
# dengan akun Google Bos, lalu BATASI key itu ke HTTP referrer
# https://kyber-agent-living-world.vercel.app/* — key ikut terbungkus ke
# bundle JS publik, jadi tanpa batasan referrer siapa pun bisa memakainya.
# Bila kosong, engine jalan dalam mode simulasi lokal (diberi label jelas).
VITE_GEMINI_API_KEY=
# Model default; ubah bila model di atas tidak tersedia di tier gratis.
VITE_GEMINI_MODEL=gemini-2.5-flash
